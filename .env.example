# ===========================================================================
# Elmich Digital Worker (dw-elmichs) — environment template
# Create .env with `python scripts/init_env.py`: it copies this file and
# replaces every `change-me-*` placeholder with a random secret. It never
# overwrites an existing .env. NEVER commit a real .env.
#
# Values must stay shell-safe (no spaces, no quotes unless noted): the same
# file is read by docker compose, by `make` (include) and by scripts/dev.sh
# (`source`).
# Lines left commented are optional; the value shown is the code's default.
# ===========================================================================

# --- Compose ---------------------------------------------------------------
# Namespaces containers, networks and VOLUMES. Two checkouts sharing a name
# share (and can wipe) one Postgres volume, so this repo has its own.
COMPOSE_PROJECT_NAME=dw_elmichs

# Host ports for this checkout's infra (the other stack on this machine keeps
# the defaults). The URLs below must point at whatever is chosen here.
DW_POSTGRES_HOST_PORT=25432
DW_QDRANT_HOST_PORT=26333
DW_QDRANT_GRPC_HOST_PORT=26334
DW_VALKEY_HOST_PORT=26379
# The S3 object store (SeaweedFS); the name is kept from MinIO days.
DW_MINIO_HOST_PORT=29000
# Moving Keycloak's port also means moving KC_HOSTNAME and every issuer URL.
DW_KEYCLOAK_HOST_PORT=28686
# Document sandbox gateway; DW_DOCGEN_URL below must use the same port.
DW_DOCGEN_HOST_PORT=28110
# App ports of the `full` compose profile (defaults shown).
# DW_API_HOST_PORT=8000
# DW_WEB_HOST_PORT=3200
# Optional observability profile ports (defaults shown).
# DW_LANGFUSE_HOST_PORT=3001
# DW_ALERTMANAGER_HOST_PORT=9093
# DW_PROMETHEUS_HOST_PORT=9090

# --- PostgreSQL ------------------------------------------------------------
# Superuser created on first init of the volume; also Keycloak's DB login.
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=change-me-admin
# Database the superuser connects to on init.
POSTGRES_DB=postgres
# Passwords of the four platform roles, set once when the volume is created.
DW_DB_MIGRATOR_PASSWORD=change-me-migrator
DW_DB_APP_PASSWORD=change-me-app
# Read-only role for consumers outside the platform (CLAUDE.md: second language).
DW_DB_AGENT_RO_PASSWORD=change-me-agent-ro
DW_DB_PROVISIONER_PASSWORD=change-me-provisioner
# scripts/create_{agent,provisioner}_role.py connect as the superuser above to
# the `postgres` database: either this full URL, or POSTGRES_USER/PASSWORD on
# DW_DB_HOST:DW_DB_PORT (defaults 127.0.0.1 and DW_POSTGRES_HOST_PORT).
# DW_ADMIN_DATABASE_URL=
# DW_DB_HOST=127.0.0.1
# DW_DB_PORT=25432

# Migrations and seeds only: dw_migrator holds BYPASSRLS.
DW_DATABASE_URL=postgresql+asyncpg://dw_migrator:change-me-migrator@127.0.0.1:25432/dw
# Every process that serves tenant data connects as dw_app, where RLS applies.
DW_API_DATABASE_URL=postgresql+asyncpg://dw_app:change-me-app@127.0.0.1:25432/dw
DW_WORKER_DATABASE_URL=postgresql+asyncpg://dw_app:change-me-app@127.0.0.1:25432/dw
# Provisioning role (ADR-002) for /api/v1/platform/*; unset hides that surface.
DW_PROVISIONER_DATABASE_URL=postgresql+asyncpg://dw_provisioner:change-me-provisioner@127.0.0.1:25432/dw
# API request pool size and overflow.
# DW_API_DB_POOL_SIZE=10
# DW_API_DB_MAX_OVERFLOW=20

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:26333
# Only needed when the Qdrant server enforces an API key (shared servers).
QDRANT_API_KEY=
# Fixed vector width per collection: a new embedding provider needs a new name.
QDRANT_COLLECTION=dw_knowledge

# --- Valkey (Redis-compatible; a cache, never a source of truth) ----------
REDIS_URL=redis://127.0.0.1:26379/0

# --- Object storage (S3-compatible; SeaweedFS in compose) ------------------
# Root credentials of the object store; api and worker sign requests with them.
MINIO_ROOT_USER=dw-minio
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT_URL=http://127.0.0.1:29000
# Knowledge artifacts, tenant-offboarding exports, Postgres backups.
S3_BUCKET_ARTIFACTS=dw-artifacts
S3_BUCKET_EXPORTS=dw-exports
S3_BUCKET_PG_BACKUPS=dw-pg-backups
# Feedback attachments (api and worker must agree).
# DW_API_FEEDBACK_BUCKET=feedback
# DW_WORKER_FEEDBACK_BUCKET=feedback
# Supply Chain case documents (ADR 0021): one name for api, worker and the
# compose bucket job.
# CASE_DOCUMENTS_BUCKET=case-documents

# --- Keycloak (auth hostname) ----------------------------------------------
# Bootstrap admin of the Keycloak master realm.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# Public URL of Keycloak = the auth hostname; tokens carry it as `iss`.
# Hosted: https://auth.<domain>.
KC_HOSTNAME=http://localhost:28686
# The seed stamps users' external identities with DW_API_OIDC_ISSUER_URL (below);
# set DW_KEYCLOAK_ISSUER only to override that.
# Shared password scripts/keycloak_dev_users.py gives every seeded user (local only).
DW_DEV_USER_PASSWORD=change-me-dev-users

# --- API (api hostname) ----------------------------------------------------
# local | test | uat | production. uat and production are both deployed and
# obey identical rules (no mocks, no dev auth, explicit CORS); the uat/prod
# compose overlays pin it.
DW_API_PROFILE=local
# Port `make dev` serves the API on, and the interface it binds.
DW_API_PORT=8200
# Web dev server port (scripts/dev.sh); the realm's redirect URIs use it too.
DW_WEB_PORT=3200
# DW_API_HOST=0.0.0.0
# oidc = Keycloak realm; dev = local HS256 JWT (forbidden when deployed).
DW_API_AUTH_MODE=oidc
# HS256 key for dev auth and scripts/issue_dev_token.py (>= 32 chars).
DW_API_DEV_SECRET=change-me-dev-secret-at-least-32-chars
# Must equal KC_HOSTNAME + /realms/<realm>, byte for byte.
DW_API_OIDC_ISSUER_URL=http://localhost:28686/realms/dw
# `aud` the API requires in access tokens.
DW_API_OIDC_AUDIENCE=dw-api
# JWKS endpoint; unset = derived from the issuer. Compose sets the internal one.
# DW_API_OIDC_JWKS_URL=
# Browser origins allowed to call the API, a JSON array in single quotes.
# Unset in local/test = the local web origins; REQUIRED when deployed (compose
# passes it to the api). Leave it unset in a local .env: compose and `source`
# strip the quotes, but the Makefile's `include .env` keeps them and every
# ApiSettings() then fails to parse.
# Local leaves this unset: the API allows the origin of DW_PUBLIC_WEB_URL.
# A deployed profile must list the portal's HTTPS origin(s) as JSON.
# DW_API_CORS_ORIGINS=["https://app.example.com"]
# A new SSO identity gets no membership unless this is true (default-deny).
DW_API_AUTO_PROVISION_MEMBERSHIP=false
# Membership given when auto-provisioning is on (defaults live in settings.py).
# DW_API_DEFAULT_TENANT_ID=
# DW_API_DEFAULT_WORKSPACE_ID=
# DW_API_DEFAULT_ROLE=member
# Requests per caller per minute; 0 disables.
# DW_API_RATE_LIMIT_PER_MINUTE=240
# Extra hosts the outbound SSRF guard accepts, a JSON array in single quotes.
# DW_API_OUTBOUND_ALLOWED_HOSTS='["gateway.internal"]'
# Public URL of the web app = the web hostname; links in reminders point here.
DW_PUBLIC_WEB_URL=http://localhost:3200
# Public URL of the API = the api hostname. Nothing reads it yet: it becomes an
# active key in the Zalo webhook ticket (zalo-channel/issues/03), together with
# the settings field that reads it.
# DW_API_PUBLIC_BASE_URL=http://localhost:8200
# Approval reminder delay; 5 is a demo value, use a real SLA (e.g. 1800) elsewhere.
DW_APPROVAL_REMINDER_SECONDS=5
# Task connector: mock (local only) | none (required when deployed).
DW_TASK_CONNECTOR=mock

# --- Worker ----------------------------------------------------------------
# Liveness heartbeat cadence (s).
DW_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
# Supply Chain follow-up sweep cadence (10..86400 s); 60 when testing reminders.
DW_WORKER_SUPPLY_CHAIN_FOLLOW_UP_INTERVAL_SECONDS=300
# Prometheus scrape port of the worker.
# DW_WORKER_METRICS_PORT=9464
# Model the worker reads uploaded documents and images with.
# DW_WORKER_EXTRACTION_MODEL=gpt-5.6-luna
# Main loop tick (s).
# DW_WORKER_POLL_INTERVAL_SECONDS=1
# Liveness file (scripts/dev.sh sets .dw/worker-heartbeat) and repo root (the image sets /app).
# DW_WORKER_HEARTBEAT_FILE=/tmp/dw-worker-heartbeat
# DW_WORKER_REPO_ROOT=
# Ingest and outbox tuning (defaults and limits in apps/worker/src/dw_worker/settings.py).
# DW_WORKER_INGEST_BATCH_SIZE=4
# DW_WORKER_INGEST_LEASE_SECONDS=
# DW_WORKER_INGEST_JOB_TIMEOUT_SECONDS=
# DW_WORKER_INGEST_HEARTBEAT_SECONDS=
# DW_WORKER_INGEST_RETRY_BACKOFF_SECONDS=
# DW_WORKER_OUTBOX_BATCH_SIZE=8
# DW_WORKER_OUTBOX_MAX_ATTEMPTS=3

# --- Web (web hostname) ----------------------------------------------------
# Baked into the browser bundle at build time: rebuild the web image to change.
# The API as the browser reaches it (= DW_API_PUBLIC_BASE_URL when hosted).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8200
# oidc = real Keycloak login | dev = one-click persona picker.
NEXT_PUBLIC_AUTH_MODE=oidc
# Keycloak as the browser reaches it (= KC_HOSTNAME).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:28686
# Realm and public client the web logs in with (infra/keycloak/dw-realm.json).
NEXT_PUBLIC_KEYCLOAK_REALM=dw
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dw-web

# --- Zalo channel --------------------------------------------------------
# One bot per deployment (Zalo Bot Platform). Read by api and worker; empty
# token or empty link secret = the channel is off: /api/v1/zalo/* answers 404
# and the worker registers no poll lane. Only ONE process may poll a bot at a
# time: another checkout or product polling the same token steals updates.
ZALO_BOT_TOKEN=
# HMAC key signing the one-time /start link token; api and worker share it.
# A long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
ZALO_LINK_SECRET=
# Deep link to the bot shown on the settings page (https://zalo.me/...); empty = none.
ZALO_BOT_LINK=
# poll = the worker long-polls (local, no public URL) | webhook = Zalo calls the API (public HTTPS).
ZALO_UPDATES_MODE=poll
# What the bot calls this deployment in its replies ("tài khoản <name>").
DW_PRODUCT_NAME=Elmich
# Secret path segment of the webhook URL. Not read yet: it becomes active in
# zalo-channel/issues/03 together with the setting that reads it.
# ZALO_WEBHOOK_SECRET=change-me-zalo-webhook
# Cadence of the worker lane that sends notifications to linked Zalo chats (5..3600 s).
DW_WORKER_CHANNEL_DELIVERY_INTERVAL_SECONDS=30

# --- Model providers (empty = deterministic mock) --------------------------
# mock (local only) | openai_compatible (any /chat/completions endpoint).
DW_MODEL_PROVIDER=mock
# A file in configs/models/: balanced (mock) | deepseek | gateway | low_cost | luna | openai.
DW_API_MODEL_PROFILE=balanced
# The OpenAI-dialect endpoint and key; probe with `make check-model`.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# json_schema | json_object, whichever the endpoint honours.
DW_API_OPENAI_STRUCTURED_MODE=json_schema
# Responses-API strict structured output.
# DW_API_OPENAI_STRICT_SCHEMA=true
# Speech-to-text for uploaded recordings; empty = audio uploads are refused.
DEEPGRAM_API_KEY=

# --- Retrieval index --------------------------------------------------------
# "hash" (offline default, dim 64) | "openai_compatible" (the gateway above;
# model and width come from the `embedding` route of DW_API_MODEL_PROFILE).
# Any other value is refused at startup.
DW_API_EMBEDDING_PROVIDER=hash
DW_WORKER_EMBEDDING_PROVIDER=hash
# Reranking of retrieved chunks, through a hosted API (nothing self-hosted).
# "none" (default) keeps the vector order; "cohere_compatible" calls
# POST {base_url}/rerank. Only the API reranks; the worker only ingests.
# Probe it with `make check-rerank`. If the provider is down, search keeps the
# vector order and logs a warning instead of failing.
# DW_API_RERANK_PROVIDER=cohere_compatible
# DW_API_RERANK_BASE_URL=https://mkp-api.fptcloud.com/v1
# DW_API_RERANK_API_KEY=<FPT Cloud AI Marketplace key with bge-reranker-v2-m3 permission>
# DW_API_RERANK_MODEL=bge-reranker-v2-m3
# DW_API_RERANK_TIMEOUT_SECONDS=10

# --- Document sandbox (apps/docgen) ----------------------------------------
# Optional bearer token for the sandbox; leave empty unless every caller sends it.
DW_DOCGEN_TOKEN=
# Where a host process reaches the sandbox (through docgen-gateway).
DW_DOCGEN_URL=http://127.0.0.1:28110

# --- Observability (optional `observability` profile) ----------------------
# OTLP endpoint; empty = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3210
# Keys of a Langfuse project (created in its UI); required when enabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse server's own secrets; compose requires them even when the profile is off.
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth
LANGFUSE_SALT=change-me-langfuse-salt
# 64 hex characters (init_env.py generates exactly that).
LANGFUSE_ENCRYPTION_KEY=change-me-langfuse-encryption
CLICKHOUSE_PASSWORD=change-me-clickhouse
# Where Alertmanager POSTs a firing alert; empty = visible in its UI only.
ALERTMANAGER_WEBHOOK_URL=

# --- Integration tests -----------------------------------------------------
# 127.0.0.1, never `localhost`: localhost tries ::1 first here and every
# connection waits for that to fail.
DW_TEST_DB_HOST=127.0.0.1
# = DW_POSTGRES_HOST_PORT.
DW_TEST_DB_PORT=25432
