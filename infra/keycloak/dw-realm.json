      "email": "binh.tran@alpha.local",
      "firstName": "Bình",
      "lastName": "Trần",
      "enabled": false,
      "emailVerified": true
    },
    {
      "id": "c0000000-0000-4000-8000-0000000000c3",
      "username": "chi",
      "email": "chi.le@alpha.local",
      "firstName": "Chi",
      "lastName": "Lê",
      "enabled": false,
      "emailVerified": true
    }
  ]
}
