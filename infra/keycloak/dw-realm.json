{
  "realm": "dw",
  "displayName": "Digital Worker",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "sslRequired": "external",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "dw-web",
      "name": "Digital Worker Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3200/*", "http://127.0.0.1:3200/*"],
      "webOrigins": ["http://localhost:3200", "http://127.0.0.1:3200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3200/*"
      },
      "protocolMappers": [
        {
          "name": "dw-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dw-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "a0000000-0000-4000-8000-0000000000a1",
